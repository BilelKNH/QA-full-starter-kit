# ── Cible ─────────────────────────────────────────────────────────────────────
# true  : l'app de démonstration Nimbus est démarrée automatiquement
# false : viser une application externe via BASE_URL / API_URL
USE_DEMO_APP=true
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# ── Comptes de référence (organisation de démonstration) ──────────────────────
TEST_OWNER_EMAIL=owner@acme.test
TEST_OWNER_PASSWORD=Passw0rd!
TEST_ADMIN_EMAIL=admin@acme.test
TEST_ADMIN_PASSWORD=Passw0rd!
TEST_MEMBER_EMAIL=member@acme.test
TEST_MEMBER_PASSWORD=Passw0rd!

# ── Timeouts (ms) ─────────────────────────────────────────────────────────────
TEST_TIMEOUT=30000
EXPECT_TIMEOUT=5000
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=15000
API_TIMEOUT=10000

TEST_ENV=local
